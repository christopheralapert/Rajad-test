{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-tests",
    "rootDir": ".",
    "types": [],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/domain/track.ts",
    "src/pages/filterUtils.ts",
    "src/__tests__/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-tests"]
}
